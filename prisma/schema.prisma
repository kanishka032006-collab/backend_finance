generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/tridin-client"
  // Each host generates its own engine during install/build (Windows locally, Linux on Render).
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  COLLECTION_STAFF
  READ_ONLY_AUDITOR
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CLOSED
}

enum InstalmentStatus {
  UPCOMING
  DUE
  PARTIAL
  OVERDUE
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

enum AdjustmentType {
  WAIVER
  PENALTY
  DISCOUNT
  CORRECTION
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(COLLECTION_STAFF)
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentsCollected  Payment[]    @relation("Collector")
  paymentsReversed   Payment[]    @relation("Reverser")
  adjustmentsCreated Adjustment[]
  auditLogs          AuditLog[]
  assignedCustomers  Customer[]   @relation("AssignedCollector")

  @@map("users")
}

model Customer {
  id                  String    @id @default(uuid())
  customerCode        String    @unique
  name                String
  mobile              String
  address             String
  kycStatus           KycStatus @default(PENDING)
  startDate           DateTime  @default(now())
  notes               String?   @db.Text
  assignedCollectorId String?
  assignedCollector   User?     @relation("AssignedCollector", fields: [assignedCollectorId], references: [id], onDelete: SetNull)
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts FinanceAccount[]
  payments Payment[]

  @@index([assignedCollectorId])
  @@map("customers")
}

model FinanceAccount {
  id               String        @id @default(uuid())
  accountNumber    String        @unique
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agreedRepayment  Decimal       @db.Decimal(12, 2)
  actualDisbursed  Decimal       @db.Decimal(12, 2)
  grossDifference  Decimal       @db.Decimal(12, 2)
  weeklyInstalment Decimal       @db.Decimal(12, 2)
  totalWeeks       Int
  firstDueDate     DateTime
  dueDay           String
  status           AccountStatus @default(ACTIVE)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  instalments Instalment[]
  payments    Payment[]
  adjustments Adjustment[]

  @@map("accounts")
}

model Instalment {
  id              String           @id @default(uuid())
  accountId       String
  account         FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  weekNumber      Int
  dueDate         DateTime
  scheduledAmount Decimal          @db.Decimal(12, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(12, 2)
  status          InstalmentStatus @default(UPCOMING)
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  allocations PaymentAllocation[]
  adjustments Adjustment[]

  @@unique([accountId, weekNumber])
  @@map("instalments")
}

model Payment {
  id             String         @id @default(uuid())
  receiptNumber  String         @unique
  accountId      String
  account        FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  collectorId    String
  collector      User           @relation("Collector", fields: [collectorId], references: [id], onDelete: Restrict)
  amount         Decimal        @db.Decimal(12, 2)
  paymentDate    DateTime       @default(now())
  paymentMethod  PaymentMethod  @default(CASH)
  reference      String?        @db.VarChar(100)
  notes          String?        @db.Text
  status         PaymentStatus  @default(COMPLETED)
  reversedAt     DateTime?
  reversalReason String?        @db.Text
  reversedById   String?
  reversedBy     User?          @relation("Reverser", fields: [reversedById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id              String     @id @default(uuid())
  paymentId       String
  payment         Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  instalmentId    String
  instalment      Instalment @relation(fields: [instalmentId], references: [id], onDelete: Restrict)
  allocatedAmount Decimal    @db.Decimal(12, 2)
  createdAt       DateTime   @default(now())

  @@map("payment_allocations")
}

model Adjustment {
  id           String         @id @default(uuid())
  accountId    String
  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  instalmentId String?
  instalment   Instalment?    @relation(fields: [instalmentId], references: [id], onDelete: SetNull)
  type         AdjustmentType
  amount       Decimal        @db.Decimal(12, 2)
  reason       String         @db.Text
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())

  @@map("adjustments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
